{
  "identifier": "main",
  "description": "Main window only; no filesystem, shell or network plugin access.",
  "windows": ["main", "terminal-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "allow-recovery-list",
    "allow-recovery-create",
    "allow-recovery-restore",
    "allow-diagnostics-export",
    "allow-sessions",
    "allow-save-session",
    "allow-delete-session",
    "allow-duplicate-session",
    "allow-save-group",
    "allow-connect",
    "allow-disconnect",
    "allow-trust-host",
    "allow-auth-reply",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-sftp-list",
    "allow-sftp-change",
    "allow-transfer-pick",
    "allow-transfer-drop",
    "allow-transfer-list",
    "allow-transfer-cancel",
    "allow-edit-start",
    "allow-edit-list",
    "allow-edit-resolve",
    "allow-detach-terminal",
    "allow-detached-info",
    "allow-attach-terminal",
    "allow-tunnel-configs",
    "allow-tunnel-save",
    "allow-tunnel-start",
    "allow-tunnel-stop",
    "allow-tunnel-list",
    "allow-config-export",
    "allow-config-import",
    "allow-config-preview",
    "allow-config-apply",
    "allow-monitor-get",
    "allow-monitor-configure",
    "core:window:allow-close",
    "allow-edit-close",
    "allow-vault-status",
    "allow-vault-lock",
    "allow-vault-action",
    "allow-broadcast-status",
    "allow-broadcast-set",
    "allow-edit-mode",
    "allow-editor-pick",
    "allow-file-batch",
    "allow-file-clipboard",
    "allow-archive-run",
    "allow-transfer-resume",
    "allow-transfer-discard",
    "allow-local-targets",
    "allow-local-open",
    "allow-local-input",
    "allow-local-resize",
    "allow-local-ack",
    "allow-local-close"
  ]
}
