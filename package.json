{
  "name": "dachsterm",
  "version": "0.5.1",
  "private": true,
  "overrides": {
    "minimatch@^10.2.6": "11.0.1",
    "dompurify": "3.4.17"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run src",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "probe": "node scripts/run-probe.mjs",
    "probe:phase1": "node scripts/run-phase1.mjs",
    "test:native": "node scripts/run-phase1.mjs --native",
    "test:drag-out": "node scripts/test-local-native.mjs --drag-only",
    "test:file-tab": "node scripts/test-local-native.mjs --file-tab-only",
    "test:document-editor": "node scripts/test-local-native.mjs --document-editor-only",
    "test:git-settings": "node scripts/test-local-native.mjs --git-settings-only",
    "test:git-diff": "node scripts/test-local-native.mjs --git-diff-only",
    "test:native:edit": "node scripts/run-phase1.mjs --native --edit-only --reuse-build",
    "test:ssh-key": "node scripts/test-ssh-key-native.mjs",
    "test:network-base": "node scripts/test-network-base-native.mjs",
    "test:port-tools": "node scripts/test-port-tools-native.mjs",
    "test:service-tools": "node scripts/test-port-tools-native.mjs --service-only",
    "test:session-log": "node scripts/test-session-log-native.mjs",
    "test:ui": "playwright test",
    "test:editor-trial": "node scripts/test-editor-native.mjs",
    "format": "prettier --write src scripts tests *.ts *.js *.json src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src scripts tests *.ts *.js *.json src-tauri/*.json src-tauri/capabilities/*.json",
    "probe:ftp": "node scripts/run-ftp.mjs",
    "probe:prompt-branch": "node scripts/probe-prompt-branch.mjs",
    "kube:fixture": "wsl -d Ubuntu-24.04 -- bash scripts/kube-fixture.sh",
    "test:kube-detect": "node scripts/verify-kube-detect.mjs",
    "test:kube-dashboard": "node scripts/verify-kube-tree.mjs --dashboard",
    "test:kube-tree": "node scripts/verify-kube-tree.mjs",
    "test:kube-detail": "node scripts/verify-kube-detail.mjs",
    "test:kube-log-search": "node scripts/verify-kube-log-search.mjs",
    "test:kube-workers": "node scripts/verify-kube-workers.mjs",
    "test:kube-ingress": "node scripts/verify-kube-ingress.mjs",
    "test:kube-actions": "cargo test -p dachsterm --lib --locked real_cluster_actions -- --ignored --nocapture",
    "test:kube-stream": "cargo test -p dachsterm --lib --locked real_cluster_streams -- --ignored --nocapture"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "marked": "14.0.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
